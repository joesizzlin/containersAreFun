FROM docker.io/library/ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install code-server from a pinned, checksum-verified release artifact.
# Replaces the previous `curl -fsSL https://code-server.dev/install.sh | sh`,
# which executed unpinned remote code at build time (NIST SP 800-190 3.1.3).
#
# Populate these two ARGs before building:
#   VER=$(curl -sS https://api.github.com/repos/coder/code-server/releases/latest | grep -oP '"tag_name": "v\K[^"]+')
#   curl -fsSLO https://github.com/coder/code-server/releases/download/v${VER}/code-server_${VER}_amd64.deb
#   sha256sum code-server_${VER}_amd64.deb
ARG CODE_SERVER_VERSION=REPLACE_ME
ARG CODE_SERVER_SHA256=REPLACE_ME

RUN curl -fsSL -o /tmp/code-server.deb \
      "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_amd64.deb" \
    && echo "${CODE_SERVER_SHA256}  /tmp/code-server.deb" | sha256sum -c - \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/code-server.deb \
    && rm -f /tmp/code-server.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -g 1000 devuser \
    && useradd -m -u 1000 -g 1000 -s /bin/bash devuser

# Working directory
WORKDIR /workspace

# Give devuser ownership
RUN chown -R devuser:devuser /workspace

# Switch to non-root user
USER devuser

# Expose VS Code Server port
EXPOSE 8080

# Start VS Code Server with password auth
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "password", "/workspace"]

